rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedInAs(uid) {
      return request.auth != null
        && request.auth.uid == uid;
    }

    function validDraft(uid, docId, versionId) {
      let user = firestore.get(
        /databases/(default)/documents/users/$(uid)
      );

      let document = firestore.get(
        /databases/(default)/documents/documents/$(docId)
      );

      return user.data.sellerEnabled == true
        && document.data.sellerId == uid
        && document.data.status == 'DRAFT'
        && document.data.activeVersionId == versionId;
    }

    function allowedUploader(uid, docId, versionId) {
      return signedInAs(uid)
        && validDraft(uid, docId, versionId);
    }

    function isPublishedPreview(docId, versionId, fileName) {
      let catalog = firestore.get(
        /databases/(default)/documents/catalog/$(docId)
      );

      let previewPath =
        'previews/' + docId + '/' + versionId + '/' + fileName;

      return catalog.data.previewRefs is list
        && previewPath in catalog.data.previewRefs;
    }

    match /avatars/{uid}/{fileName} {
      allow get, delete: if signedInAs(uid)
        && fileName.matches('[a-f0-9-]{36}\\.jpg');
      allow create: if signedInAs(uid)
        && resource == null
        && fileName.matches('[a-f0-9-]{36}\\.jpg')
        && request.resource.size > 0
        && request.resource.size <= 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow list, update: if false;
    }

    // PDF goc: client khong duoc doc, ghi hoac tai truc tiep.
    match /private/{allPaths=**} {
      allow read, write: if false;
    }

    // Seller chi duoc tao mot PDF trong staging cua draft.
    match /staging/{uid}/{docId}/{versionId}/pdf/{fileName} {
      allow get: if allowedUploader(uid, docId, versionId);
      allow list: if false;

      allow create: if
        allowedUploader(uid, docId, versionId)
        && fileName == 'source.pdf'
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';

      allow update, delete: if false;
    }

    // Toi da 5 anh preview, moi anh toi da 5 MiB.
    match /staging/{uid}/{docId}/{versionId}/previews/{fileName} {
      allow get: if allowedUploader(uid, docId, versionId);
      allow list: if false;

      allow create: if
        allowedUploader(uid, docId, versionId)
        && fileName.matches('[1-5]\\.(jpg|jpeg|png)')
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && (
          request.resource.contentType == 'image/jpeg'
          || request.resource.contentType == 'image/png'
        );

      allow update, delete: if false;
    }

    // Chi anh co trong catalog previewRefs moi duoc doc.
    // Archive xoa catalog -> mat quyen doc.
    match /previews/{docId}/{versionId}/{fileName} {
      allow get: if isPublishedPreview(
        docId, versionId, fileName
      );

      allow list, create, update, delete: if false;
    }

    // Mac dinh chan moi duong dan khac.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}