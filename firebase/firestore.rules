rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid;
    }

    function validProfile() {
      let data = request.resource.data;

      return data.keys().hasAll([
          'displayName', 'school', 'faculty'
        ])
        && data.displayName is string
        && data.school is string
        && data.faculty is string
        && data.displayName.size() <= 100
        && data.school.size() <= 150
        && data.faculty.size() <= 150
        && (
          !('avatarUrl' in data)
          || data.avatarUrl == null
          || data.avatarUrl is string
        );
    }

    // Ho so rieng: chi chu tai khoan duoc doc/sua.
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'displayName', 'school', 'faculty', 'avatarUrl'
        ])
        && validProfile();

      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'displayName', 'school', 'faculty', 'avatarUrl'
          ])
        && validProfile();

      allow delete: if false;
    }

    // Catalog la public projection do backend quan ly.
    // Backend chi tao khi publish, xoa khi archive.
    match /catalog/{docId} {
      allow get: if true;
      allow list: if request.query.limit != null
        && request.query.limit <= 20;
      allow create, update, delete: if false;
    }

    // Thong tin Seller cong khai, khong chua email/thanh toan.
    match /sellerPublic/{uid} {
      allow get: if true;
      allow list: if request.query.limit != null
        && request.query.limit <= 20;
      allow create, update, delete: if false;
    }

    // Buyer chi duoc doc entitlement cua chinh minh.
    // Chi backend Admin SDK duoc cap, sua hoac thu hoi quyen.
    match /entitlements/{uid}/items/{docId} {
      allow get: if isOwner(uid);
      allow list, create, update, delete: if false;
    }
    // Tat ca collection khac deu bi chan mac dinh.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
